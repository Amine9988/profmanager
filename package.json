{
  "name": "profmanager",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "node scripts/start-dev.mjs",
    "browser": "node scripts/start-browser.mjs",
    "tunnel": "node scripts/start-tunnel.mjs",
    "public": "node scripts/start-public.mjs",
    "build": "next build",
    "start": "next start --port 3456",
    "lint": "eslint",
    "build:render": "next build && node scripts/render-postbuild.js",
    "postinstall": "node scripts/postinstall.js",
    "build:electron": "node scripts/build-electron.js",
    "build:quick": "rebuild.bat",
    "build:full": "node scripts/build-electron.js",
    "build:publish": "node scripts/build-electron.js && node scripts/publish-r2.js",
    "publish:r2": "node scripts/publish-r2.js",
    "build:mac": "node scripts/build-electron.js && npx electron-builder --mac --x64 --arm64 -c.electronDist=node_modules/electron/dist --config electron/package.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-progress": "^1.1.10",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-toast": "^1.2.17",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dijkstrajs": "^1.0.3",
    "docx": "^9.7.1",
    "encode-utf8": "^2.0.0",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.2.3",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.21.0",
    "next": "^16.2.10",
    "next-intl": "^4.13.0",
    "papaparse": "^5.5.4",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "xmldom": "^0.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^20.19.43",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
