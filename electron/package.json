{
  "name": "profmanager-desktop",
  "version": "1.0.20",
  "description": "ProfManager — Gestion de cours particuliers",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "publish": "electron-builder --win --publish always",
    "package": "electron-builder --dir",
    "installer": "electron-builder --win --prepackaged=dist/win-unpacked",
    "dist": "node ../scripts/build-electron.js"
  },
  "author": "Slimani Amine",
  "license": "MIT",
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.profmanager.desktop",
    "productName": "ProfManager",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "electronLanguages": [
      "fr",
      "ar",
      "en-US",
      "en-GB"
    ],
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "license.js",
      "activation.html",
      "activation-preload.js",
      "package.json",
      "public/icon.ico"
    ],
    "extraResources": [
      {
        "from": "standalone-server",
        "to": "standalone-server"
      },
      {
        "from": "platform-tools",
        "to": "platform-tools"
      },
      {
        "from": "build/app-update.yml",
        "to": "."
      }
    ],
    "icon": "public/icon.ico",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "signExecutable": false,
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "public/icon.icns",
      "category": "public.app-category.education",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": null,
      "entitlementsInherit": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ProfManager",
      "uninstallDisplayName": "ProfManager",
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "generic",
      "url": "https://pub-a093dfe3d51241128f512f880dc36324.r2.dev/",
      "channel": "latest"
    }
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "node-machine-id": "^1.1.12"
  }
}
