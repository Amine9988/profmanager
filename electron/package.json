{
  "name": "profmanager-desktop",
  "version": "1.0.32",
  "description": "ProfManager — Gestion de cours particuliers",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "publish": "electron-builder --win --publish always",
    "package": "electron-builder --dir",
    "installer": "electron-builder --win --prepackaged=dist/win-unpacked",
    "dist": "node ../scripts/build-electron.js",
    "build:mac": "node ../scripts/ci-mac-dmg.js"
  },
  "author": "Slimani Amine",
  "license": "MIT",
  "devDependencies": {
    "electron": "35.7.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.profmanager.desktop",
    "productName": "ProfManager",
    "directories": {
      "output": "dist",
      "buildResources": "public"
    },
    "asar": false,
    "electronLanguages": [
      "fr",
      "ar",
      "en-US",
      "en-GB"
    ],
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "license.js",
      "activation.html",
      "activation-preload.js",
      "package.json",
      "public/icon.ico",
      "public/icon.icns",
      "public/icon.png"
    ],
    "afterPack": "./after-pack.js",
    "extraResources": [
      {
        "from": "standalone-server",
        "to": "standalone-server",
        "filter": [
          "**/*",
          "!.env",
          "!.env.*",
          "!**/.env",
          "!**/.env.*"
        ]
      },
      {
        "from": "platform-tools",
        "to": "platform-tools"
      },
      {
        "from": "app-update.yml",
        "to": "."
      }
    ],
    "icon": "public/icon.icns",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "signExecutable": false,
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/icon.icns",
      "category": "public.app-category.education",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "artifactName": "ProfManager Setup ${version}-${arch}.${ext}",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "ProfManager uses the local network so a phone can scan attendance cards on the same Wi-Fi.",
        "NSBluetoothAlwaysUsageDescription": "ProfManager may use Bluetooth accessories for card readers.",
        "NSBluetoothPeripheralUsageDescription": "ProfManager may use Bluetooth accessories for card readers."
      }
    },
    "dmg": {
      "title": "ProfManager ${version}",
      "backgroundColor": "#ecf2f8",
      "icon": "public/icon.icns",
      "iconSize": 80,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ProfManager",
      "uninstallDisplayName": "ProfManager",
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "generic",
      "url": "https://pub-a093dfe3d51241128f512f880dc36324.r2.dev/",
      "channel": "latest"
    }
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "jimp": "^0.22.12",
    "node-machine-id": "^1.1.12",
    "sharp": "^0.35.4"
  }
}
